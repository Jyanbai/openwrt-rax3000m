#!/bin/sh /etc/rc.common

USE_PROCD=1
START=18
STOP=89

PROG=/usr/sbin/portal-dns-guard

start_service() {
	config_load portal-dns-guard
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	# This is deliberately synchronous and runs before dnsmasq START=19.
	# An empty servers-file is a valid, fail-closed dnsmasq configuration.
	"$PROG" --init || return 1

	procd_open_instance
	procd_set_param command "$PROG" --run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/portal-dns-guard
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger portal-dns-guard
}
