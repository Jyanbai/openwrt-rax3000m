config guard 'main'
	option defaults_version '0'
	option enabled '1'
	option interface 'wan'
	# Keep this below /tmp/hosts so OpenWrt mounts the parent directory into
	# dnsmasq's jail.  Atomic rename is then visible when dnsmasq reopens it.
	option servers_file '/tmp/hosts/portal-dns/servers'
	option state_file '/tmp/portal-dns.state'
	option poll_interval '10'
	option grace_period '600'
	option success_threshold '3'
	option failure_threshold '3'
	option signal_cooldown '30'
	option probe_timeout '4'
	option doh_address '127.0.0.1'
	option doh_port '5354'
	option doh_probe_name 'www.baidu.com'
	option connectivity_url ''
	option connectivity_host ''
	option connectivity_expected ''

# The connectivity probe fields are intentionally empty.
# Configure them only after a controlled pre-authentication capture identifies
# an endpoint whose exact expected body distinguishes ONLINE from CAPTIVE.
# Prefer an HTTP URL with a stable literal IP and put its required Host header
# in connectivity_host: dnsmasq is deliberately fail-closed during this probe.
# TODO: do not add dns.msftncsi.com to dnsmasq rebind_domain until a capture
# proves that the campus portal requires that exception.
